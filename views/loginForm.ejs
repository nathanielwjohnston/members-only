<%- include("partials/formErrors.ejs") %>
<form action="/login" method="post">
  <label for="username">Username:</label>
  <input type="text" name="username" value="<%= locals.values.username %>" />

  <!-- ?? avoids treating values like 0 as null, unlike || -->

  <label for="password">Password:</label>
  <input
    type="text"
    name="password"
    id="password"
    value="<%= locals.values.password %>"
  />
  <button type="submit">Login</button>
</form>
